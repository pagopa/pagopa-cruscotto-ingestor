let start=datetime('${start}');
let end=datetime('${end}');
${table_name}
| where INSERTED_TIMESTAMP between (start .. end)
| sort by INSERTED_TIMESTAMP asc
| project INSERTED_TIMESTAMP, IS_EVENT_MULTI_PAYMENT, NAV, PA_EMITTENTE, IUV, TOKEN, INTERMEDIARIO_PSP, PSP, CANALE, OUTCOME, PAYMENT_METHOD, TRANSACTION_STATUS, ADDITIONAL_INFO, SESSION_ID, UNIQUE_ID, TIPO_EVENTO, SOTTO_TIPO_EVENTO, SERVICE_IDENTIFIER
${estimates}

