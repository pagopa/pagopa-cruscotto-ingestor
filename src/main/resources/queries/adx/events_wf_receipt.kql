let start=datetime('${start}');
let end=datetime('${end}');
SERT_EVENTS_WF
| where INSERTED_TIMESTAMP between (start .. end)
| where TIPO_EVENTO in ("paSendRT", "paSendRTV2")
| sort by INSERTED_TIMESTAMP asc
| project INSERTED_TIMESTAMP, IS_EVENT_MULTI_PAYMENT, NAV, PA_EMITTENTE, IUV, CREDITOR_REF_ID, TOKEN, PSP, INTERMEDIARIO_PSP, INTERMEDIARIO_PA, CANALE, STAZIONE, OUTCOME, FAULT_CODE, SESSION_ID, UNIQUE_ID, TIPO_EVENTO, SOTTO_TIPO_EVENTO, SERVICE_IDENTIFIER, PAYMENT_METHOD
${estimates}

