let start=datetime('${start}');
let end=datetime('${end}');
let end_resp=datetime_add('minute', 5, end);

// paSendRT / paSendRTV2: REQ e RESP NON vengono accorpate.
// Ogni chiamata produce una riga distinta: la REQ valorizza i campi _REQ (i _RESP restano NULL),
// la RESP valorizza i campi _RESP (i _REQ restano NULL). La union riempie con NULL tipizzati
// le colonne assenti su ciascun lato.
let req=${table_name}
| where INSERTED_TIMESTAMP between (start .. end)
| where TIPO_EVENTO in ("paSendRT", "paSendRTV2")
| where not(tolower(tostring(TIPO_EVENTO)) in ("nodochiedicatalogoserviziv2", "nodochieditemplateinformativapsp", "nodochiedilistapendentirpt", "pspchiedilistart", "nodoinviacarrellorpt", "pspinviacarrellorpt", "nodoinviarpt", "nodoinviart", "paainviart"))
| where SOTTO_TIPO_EVENTO == "REQ"
| extend PA_EMITTENTE_NORM = trim(@" ", tostring(PA_EMITTENTE))
| extend TOKEN_NORM = trim(@" ", tostring(TOKEN))
| extend NAV_NORM = trim(@" ", tostring(NAV))
| extend FAULT_CODE_NORM = toupper(trim(@" ", tostring(FAULT_CODE)))
| where not(isempty(TOKEN_NORM) and (isempty(PA_EMITTENTE_NORM) or isempty(NAV_NORM)))
| where FAULT_CODE_NORM != "PPT_TOKEN_SCONOSCIUTO"
| project INSERTED_TIMESTAMP_REQ=INSERTED_TIMESTAMP, IS_EVENT_MULTI_PAYMENT, NAV, PA_EMITTENTE, IUV, CREDITOR_REF_ID, TOKEN, PSP, INTERMEDIARIO_PSP, INTERMEDIARIO_PA, CANALE, STAZIONE, OUTCOME_REQ=OUTCOME, FAULT_CODE, SESSION_ID, UNIQUE_ID, EVENT_ID_REQ=UNIQUE_ID, TIPO_EVENTO, SOTTO_TIPO_EVENTO, SERVICE_IDENTIFIER, PAYMENT_METHOD;

let resp=${table_name}
| where INSERTED_TIMESTAMP between (start .. end_resp)
| where TIPO_EVENTO in ("paSendRT", "paSendRTV2")
| where not(tolower(tostring(TIPO_EVENTO)) in ("nodochiedicatalogoserviziv2", "nodochieditemplateinformativapsp", "nodochiedilistapendentirpt", "pspchiedilistart", "nodoinviacarrellorpt", "pspinviacarrellorpt", "nodoinviarpt", "nodoinviart", "paainviart"))
| where SOTTO_TIPO_EVENTO == "RESP"
| extend PA_EMITTENTE_NORM = trim(@" ", tostring(PA_EMITTENTE))
| extend TOKEN_NORM = trim(@" ", tostring(TOKEN))
| extend NAV_NORM = trim(@" ", tostring(NAV))
| extend FAULT_CODE_NORM = toupper(trim(@" ", tostring(FAULT_CODE)))
| where not(isempty(TOKEN_NORM) and (isempty(PA_EMITTENTE_NORM) or isempty(NAV_NORM)))
| where FAULT_CODE_NORM != "PPT_TOKEN_SCONOSCIUTO"
| project INSERTED_TIMESTAMP_RESP=INSERTED_TIMESTAMP, IS_EVENT_MULTI_PAYMENT, NAV, PA_EMITTENTE, IUV, CREDITOR_REF_ID, TOKEN, PSP, INTERMEDIARIO_PSP, INTERMEDIARIO_PA, CANALE, STAZIONE, OUTCOME_RESP=OUTCOME, FAULT_CODE, SESSION_ID, UNIQUE_ID, EVENT_ID_RESP=UNIQUE_ID, TIPO_EVENTO, SOTTO_TIPO_EVENTO, SERVICE_IDENTIFIER, PAYMENT_METHOD;

union req, resp
| sort by coalesce(INSERTED_TIMESTAMP_REQ, INSERTED_TIMESTAMP_RESP) asc
| project INSERTED_TIMESTAMP_REQ, INSERTED_TIMESTAMP_RESP, IS_EVENT_MULTI_PAYMENT, NAV, PA_EMITTENTE, IUV, CREDITOR_REF_ID, TOKEN, PSP, INTERMEDIARIO_PSP, INTERMEDIARIO_PA, CANALE, STAZIONE, OUTCOME_REQ, OUTCOME_RESP, FAULT_CODE, SESSION_ID, UNIQUE_ID, EVENT_ID_REQ, EVENT_ID_RESP, TIPO_EVENTO, SOTTO_TIPO_EVENTO, SERVICE_IDENTIFIER, PAYMENT_METHOD
${estimates}
