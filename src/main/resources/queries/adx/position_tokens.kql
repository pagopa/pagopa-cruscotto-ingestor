// I token nascono dagli activatePaymentNotice, che NON portano la FEE: al momento
// dell'attivazione la commissione non e' ancora nota. Viene quindi recuperata dagli eventi di
// pagamento, dove e' valorizzata, e agganciata qui sotto.
//
// ---------------------------------------------------------------------------------------
// QUESTA QUERY E' L'UNICA OCCASIONE PER AGGANCIARE LA COMMISSIONE
//
// La FEE viene scritta SOLO nella INSERT del token (BulkWriterImpl:399) e non esiste alcun
// percorso che la aggiorni dopo: PositionEventUpdateService tocca outcome, payment_date e
// payment_method, mai la fee. E l'insert e' first-write-wins, condizionata al registry dei token.
// Quindi una commissione che non viene agganciata QUI e' persa per sempre, e un difetto in questa
// lookup non si recupera con un re-run.
//
// COPERTURA MISURATA E DOVE STA IL BUCO (dev, 23/03, ore sorgente con eventi ingeriti): il 74,2%
// dei token incassati ha la commissione. Il 26% mancante NON e' colpa della finestra di +5 minuti,
// come verrebbe naturale pensare: l'89% dei token senza fee e' stato pagato ENTRO i 5 minuti
// (mediana 33 secondi). La causa e' alla sorgente — su ADX solo il 73,6% delle righe
// sendPaymentOutcomeV2 e il 68,3% delle V1 portano una FEE, e quei numeri coincidono con la nostra
// copertura. La finestra pesa solo per un ulteriore ~3% (i pagamenti oltre i 5 minuti).
// Allargare fee_end non servirebbe quasi a nulla: e' una domanda da fare al cliente, non una leva
// da girare.
//
// ---------------------------------------------------------------------------------------
// L'AGGANCIO E' PER TOKEN, NON PER (NAV, PA)
//
// Confermato dal cliente: la FEE e' relativa al TOKEN, cioe' al singolo tentativo di pagamento,
// non alla posizione debitoria.
//
// La versione precedente indicizzava per (NAV, PA_EMITTENTE), quindi la commissione di un
// pagamento riuscito veniva attribuita a TUTTI i tentativi su quella posizione, inclusi quelli
// falliti o abbandonati.
//
// QUANTO VALE, misurato su dev il 28/10/2026 sui dati del 23/03 a ingestione allineata: poco.
// La media e' di 1,04 token per posizione (695.533 posizioni, 720.157 token), quindi per ~96%
// delle posizioni chiave per posizione e chiave per token COINCIDONO. L'aggancio sbagliato poteva
// colpire solo i ~24.600 token in eccedenza, e solo quelli che cadevano nella stessa finestra di
// cinque minuti della SPO.
//
// Una stima precedente parlava di "5,5 tentativi per pagamento" e di un totale gonfiato cinque
// volte: era SBAGLIATA. Nasceva dal rapporto 527.343 token con fee / 95.782 incassati misurato a
// ingestione parziale, dove il denominatore era basso perche' gli esiti non erano ancora stati
// applicati — il percorso eventi e' indietro rispetto a quello dei token. Lo stesso artefatto di
// sfasamento rende inaffidabile qualunque rapporto fee/incassati calcolato mentre EVENTS_WF e'
// indietro: va ristretto alle ore sorgente i cui eventi sono gia' ingeriti.
//
// Questa resta una correzione di CORRETTEZZA — la semantica confermata dal cliente e' che la fee
// e' del token — non un recupero contabile di proporzioni.
//
// ---------------------------------------------------------------------------------------
// I CARRELLI: LA COMMISSIONE VA SU TUTTI GLI N TENTATIVI, NON SU UNO SOLO
//
// Il carrello esiste proprio per far pagare UNA sola commissione su piu' avvisi: chi paga 5
// avvisi da 100 euro fa una transazione da 500 + 1,50 di fee, non 5 commissioni da 1,50.
//
// Il cliente ha chiarito come vuole rappresentarlo: la fee va riportata su TUTTI i tentativi del
// carrello, non divisa per N e non lasciata su uno solo. A dire al lettore che quella commissione
// e' condivisa, e che quindi non va sommata, e' il flag di carrello sulla riga.
//
// NON SERVE FARE NULLA PER OTTENERLO, e qui sta il punto da non reintrodurre: ADX replica il
// valore della FEE su tutte le N righe dello split, ciascuna col PROPRIO token. Verificato su ADX
// il 29/10/2026 sul carrello 2026-03-23_-1010589750507783718 (5 avvisi, EC 90051370048): tutte e
// cinque le righe sendPaymentOutcomeV2 portano FEE = 0,28 con token diversi. Siccome la lookup qui
// sotto e' indicizzata per token, ogni activate aggancia la propria riga e ottiene la commissione.
//
// Una versione precedente filtrava la sorgente con
//     | where tostring(IS_EVENT_MULTI_PAYMENT) !~ "true"
// per tenere solo la riga "master" (flag vuoto) ed escludere le repliche (flag true), nella
// convinzione che replicare la fee gonfiasse un totale. Era sbagliato due volte: il requisito e'
// l'opposto, e un totale della fee non esiste da nessuna parte — i tre report la espongono come
// colonna per riga, senza alcun SUM. L'effetto reale del filtro era che dei 5 token del carrello
// uno solo riceveva la commissione e gli altri quattro restavano vuoti.
//
// VERIFICA DOPO IL RILASCIO: su quel carrello tutti e cinque i token devono riportare 0,28.
//
// ---------------------------------------------------------------------------------------
// DUE FONTI, SCELTE DAL TOUCHPOINT, CON RIPIEGO SULL'ALTRA
//
// Specifica del cliente (29/10/2026):
//   touchpoint PAGOPA_CHECKOUT -> la fee sta sulla closePayment-v2
//   touchpoint TOUCHPOINT_PSP  -> la fee sta sulla sendPaymentOutcome / sendPaymentOutcomeV2
//
// Implementata con una precisazione concordata: se la fonte "giusta" per quel touchpoint non
// porta la commissione, si ripiega sull'altra invece di lasciare il campo vuoto. La commissione
// si cerca SEMPRE, in entrambe le fonti, nell'ordine che il touchpoint stabilisce.
//
// IL RIPIEGO NON E' DIFENSIVO, OGGI E' LA NORMA. Misurato su ADX il 29/10/2026 (23/03, ora 10-11):
// closePayment-v2 ha 26.203 righe e ZERO con FEE — difetto noto lato sorgente, che il cliente sta
// correggendo. Nel frattempo i token Checkout la commissione ce l'hanno comunque, perche' la
// sendPaymentOutcome la porta anche per loro (copertura 74,5%, quasi identica al 72,8% dei PSP).
// Senza il ripiego, applicare la specifica alla lettera avrebbe azzerato la fee sul 100% dei
// pagamenti Checkout.
//
// Nessun filtro su OUTCOME, per scelta esplicita: la commissione va cercata comunque. Sarebbe
// stato comunque quasi ininfluente (fra le righe con fee, 153.529 OK contro 226 KO, lo 0,15%).
// Nessun filtro su SOTTO_TIPO_EVENTO: quella tabella contiene SOLO righe REQ, verificato su tutti
// e sei i tipi evento presenti.
//
// LA SCELTA SI FA SULLA RIGA DA ARRICCHIRE, NON SULLA SORGENTE. Il TOUCHPOINT non e' valorizzato
// sulle righe di pagamento — tutte e 153.755 le righe con fee lo hanno vuoto — ma solo
// sull'activate, che e' appunto la riga che stiamo arricchendo. Per questo il touchpoint compare
// nell'iff finale e non in una where delle due lookup.
//
// IL PUNTO CHE LEGA QUESTA SCELTA ALLA FEE DEI CARRELLI. I carrelli esistono solo su Checkout
// (confermato dal cliente, e i nostri dati concordano: 99,4%), quindi TUTTI i carrelli ricadono
// nel ramo closePayment-v2. Oggi la commissione arriva comunque, perche' quel ramo ripiega sulla
// sendPaymentOutcome, che replica la fee su tutte le N righe. Quando la closePayment-v2 iniziera'
// a portarla, la precedenza passera' a lei per il 100% dei carrelli: se la mettesse solo sulla
// riga master, il requisito "fee su tutti i token del carrello" si romperebbe da solo, senza un
// nostro rilascio e senza che un test se ne accorga.
// IL CLIENTE HA CONFERMATO (30/10/2026) che la fee sara' su OGNI riga del carrello, come fa oggi
// la sendPaymentOutcome. Nessuna propagazione da implementare — ma se un giorno i carrelli
// Checkout dovessero tornare ad avere la commissione su un token solo, la causa e' qui.
//
// RESTA DA VERIFICARE quando il loro fix sara' attivo: con entrambe le fonti valorizzate, daranno
// lo stesso valore? Se no, il campo cambiera' da solo sui Checkout nel momento in cui loro
// rilasciano, senza alcun rilascio da parte nostra. La query di confronto sta in §8.7
// dell'handover di ingestion.
// ---------------------------------------------------------------------------------------

let start=datetime('${start}');
let end=datetime('${end}');
let fee_end=datetime_add('minute', 5, end);
let fee_from_close =
${table_name}
| where INSERTED_TIMESTAMP between (start .. fee_end)${pa_filter}
| where TIPO_EVENTO == "closePayment-v2"
| where isnotempty(trim(" ", tostring(TOKEN)))
| where isnotempty(trim(" ", tostring(FEE)))
| project TOKEN_KEY = trim(" ", tostring(TOKEN)), INSERTED_TIMESTAMP, FEE_CLOSE = FEE
| summarize arg_min(INSERTED_TIMESTAMP, FEE_CLOSE) by TOKEN_KEY
| project TOKEN_KEY, FEE_CLOSE;
let fee_from_outcome =
${table_name}
| where INSERTED_TIMESTAMP between (start .. fee_end)${pa_filter}
| where TIPO_EVENTO in ("sendPaymentOutcome", "sendPaymentOutcomeV2")
| where isnotempty(trim(" ", tostring(TOKEN)))
| where isnotempty(trim(" ", tostring(FEE)))
| project TOKEN_KEY = trim(" ", tostring(TOKEN)), INSERTED_TIMESTAMP, FEE_OUTCOME = FEE
| summarize arg_min(INSERTED_TIMESTAMP, FEE_OUTCOME) by TOKEN_KEY
| project TOKEN_KEY, FEE_OUTCOME;

${table_name}
| where INSERTED_TIMESTAMP between (start .. end)${pa_filter}
| where TIPO_EVENTO in ("activatePaymentNotice", "activatePaymentNoticeV2")
| where (
	(isnotempty(trim(" ", tostring(NAV))) and isnotempty(trim(" ", tostring(PA_EMITTENTE))))
	or
	(isempty(trim(" ", tostring(NAV))) and isempty(trim(" ", tostring(PA_EMITTENTE))) and isnotempty(trim(" ", tostring(TOKEN))))
)
| extend TOKEN_KEY = trim(" ", tostring(TOKEN))
| join kind=leftouter fee_from_close on TOKEN_KEY
| join kind=leftouter fee_from_outcome on TOKEN_KEY
| extend FEE = iff(isempty(trim(" ", tostring(FEE))),
        iff(trim(" ", tostring(TOUCHPOINT)) =~ "PAGOPA_CHECKOUT",
            coalesce(FEE_CLOSE, FEE_OUTCOME),
            coalesce(FEE_OUTCOME, FEE_CLOSE)),
        FEE)
| sort by INSERTED_TIMESTAMP asc
| project INSERTED_TIMESTAMP, IS_EVENT_MULTI_PAYMENT, NAV, PA_EMITTENTE, IUV, TOKEN, AMOUNT, FEE, ID_CARRELLO, STAZIONE, INTERMEDIARIO_PA, PSP, CANALE, INTERMEDIARIO_PSP, OUTCOME, TOUCHPOINT, PAYMENT_METHOD, SESSION_ID, UNIQUE_ID, TIPO_EVENTO, SOTTO_TIPO_EVENTO, SERVICE_IDENTIFIER
${estimates}
