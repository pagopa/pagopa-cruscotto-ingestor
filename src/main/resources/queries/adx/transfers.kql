let start=datetime('${start}');
let end=datetime('${end}');
${table_name}
| where INSERTED_TIMESTAMP between (start .. end)
| where OUTCOME == "OK"
| sort by INSERTED_TIMESTAMP asc
| project INSERTED_TIMESTAMP, NAV, PA_EMITTENTE, IUV, TOKEN, ID_TRANSFER, TRANSFER_AMOUNT, PA_TRANSFER, IBAN_TRANSFER, IS_BOLLO, STAZIONE, INTERMEDIARIO_PA, PSP, CANALE, INTERMEDIARIO_PSP, OUTCOME, FAULT_CODE, SESSION_ID, UNIQUE_ID, TIPO_EVENTO, SOTTO_TIPO_EVENTO, SERVICE_IDENTIFIER
${estimates}

