<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260325-init-tables" author="system">
        <!-- POSITIONS -->
        <createTable tableName="DATALAYER_POSITIONS">
            <column name="UNIQUE_ID" type="VARCHAR(255)">
                <constraints primaryKey="true" primaryKeyName="DL_POSITION_PK"/>
            </column>
            <column name="INSERTED_TIMESTAMP" type="TIMESTAMP"/>
            <column name="NAV" type="VARCHAR(50)"/>
            <column name="PA_EMITTENTE" type="VARCHAR(50)"/>
            <column name="IUV" type="VARCHAR(35)"/>
            <column name="TOKEN" type="TEXT"/>
            <column name="STAZIONE" type="VARCHAR(255)"/>
            <column name="INTERMEDIARIO_PA" type="VARCHAR(255)"/>
            <column name="PSP" type="VARCHAR(255)"/>
            <column name="CANALE" type="VARCHAR(255)"/>
            <column name="INTERMEDIARIO_PSP" type="VARCHAR(255)"/>
            <column name="OUTCOME" type="VARCHAR(255)"/>
            <column name="FAULT_CODE" type="VARCHAR(255)"/>
            <column name="SESSION_ID" type="VARCHAR(255)"/>
            <column name="TIPO_EVENTO" type="VARCHAR(255)"/>
            <column name="SOTTO_TIPO_EVENTO" type="VARCHAR(255)"/>
            <column name="SERVICE_IDENTIFIER" type="VARCHAR(255)"/>
        </createTable>
        <createIndex tableName="DATALAYER_POSITIONS" indexName="IDX_NAV">
            <column name="NAV"/>
        </createIndex>

        <!-- POSITION_TOKENS -->
        <createTable tableName="DATALAYER_POSITION_TOKENS">
            <column name="UNIQUE_ID" type="VARCHAR(255)">
                <constraints primaryKey="true" primaryKeyName="DL_POSITION_TOKENS_PK"/>
            </column>
            <column name="INSERTED_TIMESTAMP" type="TIMESTAMP"/>
            <column name="IS_EVENT_MULTI_PAYMENT" type="BOOLEAN"/>
            <column name="NAV" type="VARCHAR(50)"/>
            <column name="PA_EMITTENTE" type="VARCHAR(50)"/>
            <column name="IUV" type="VARCHAR(35)"/>
            <column name="TOKEN" type="TEXT"/>
            <column name="AMOUNT" type="NUMERIC(15,2)"/>
            <column name="FEE" type="NUMERIC(15,2)"/>
            <column name="ID_CARRELLO" type="VARCHAR(255)"/>
            <column name="STAZIONE" type="VARCHAR(255)"/>
            <column name="INTERMEDIARIO_PA" type="VARCHAR(255)"/>
            <column name="PSP" type="VARCHAR(255)"/>
            <column name="CANALE" type="VARCHAR(255)"/>
            <column name="INTERMEDIARIO_PSP" type="VARCHAR(255)"/>
            <column name="OUTCOME" type="VARCHAR(255)"/>
            <column name="TOUCHPOINT" type="VARCHAR(255)"/>
            <column name="PAYMENT_METHOD" type="VARCHAR(255)"/>
            <column name="SESSION_ID" type="VARCHAR(255)"/>
            <column name="TIPO_EVENTO" type="VARCHAR(255)"/>
            <column name="SOTTO_TIPO_EVENTO" type="VARCHAR(255)"/>
            <column name="SERVICE_IDENTIFIER" type="VARCHAR(255)"/>
        </createTable>
        <createIndex tableName="DATALAYER_POSITION_TOKENS" indexName="IDX_TOK_NAV">
            <column name="NAV"/>
        </createIndex>
        <createIndex tableName="DATALAYER_POSITION_TOKENS" indexName="IDX_IUV">
            <column name="IUV"/>
        </createIndex>
        <createIndex tableName="DATALAYER_POSITION_TOKENS" indexName="IDX_ID_CARRELLO">
            <column name="ID_CARRELLO"/>
        </createIndex>

        <!-- POSITION_TRANSFERS -->
        <createTable tableName="DATALAYER_POSITION_TRANSFERS">
            <column name="UNIQUE_ID" type="VARCHAR(255)">
                <constraints primaryKey="true" primaryKeyName="DL_POSITION_TRANSFERS_PK"/>
            </column>
            <column name="INSERTED_TIMESTAMP" type="TIMESTAMP"/>
            <column name="NAV" type="VARCHAR(50)"/>
            <column name="PA_EMITTENTE" type="VARCHAR(50)"/>
            <column name="IUV" type="VARCHAR(35)"/>
            <column name="TOKEN" type="TEXT"/>
            <column name="ID_TRANSFER" type="INTEGER"/>
            <column name="TRANSFER_AMOUNT" type="NUMERIC(15,2)"/>
            <column name="PA_TRANSFER" type="VARCHAR(255)"/>
            <column name="IBAN_TRANSFER" type="VARCHAR(255)"/>
            <column name="IS_BOLLO" type="BOOLEAN"/>
            <column name="STAZIONE" type="VARCHAR(255)"/>
            <column name="INTERMEDIARIO_PA" type="VARCHAR(255)"/>
            <column name="PSP" type="VARCHAR(255)"/>
            <column name="CANALE" type="VARCHAR(255)"/>
            <column name="INTERMEDIARIO_PSP" type="VARCHAR(255)"/>
            <column name="OUTCOME" type="VARCHAR(255)"/>
            <column name="FAULT_CODE" type="VARCHAR(255)"/>
            <column name="SESSION_ID" type="VARCHAR(255)"/>
            <column name="TIPO_EVENTO" type="VARCHAR(255)"/>
            <column name="SOTTO_TIPO_EVENTO" type="VARCHAR(255)"/>
            <column name="SERVICE_IDENTIFIER" type="VARCHAR(255)"/>
        </createTable>

        <!-- EVENTS_WF -->
