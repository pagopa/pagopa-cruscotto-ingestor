<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="schema_name" value="sert_ingestor" />

    <changeSet id="20260511-ingest-execution-log-run-window" author="copilot">
        <addColumn schemaName="${schema_name}" tableName="INGEST_EXECUTION_LOG">
            <column name="RUN_WINDOW_FROM_TS" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="RUN_WINDOW_TO_TS" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>

        <rollback>
            <dropColumn schemaName="${schema_name}" tableName="INGEST_EXECUTION_LOG" columnName="RUN_WINDOW_FROM_TS"/>
            <dropColumn schemaName="${schema_name}" tableName="INGEST_EXECUTION_LOG" columnName="RUN_WINDOW_TO_TS"/>
        </rollback>
    </changeSet>
</databaseChangeLog>

