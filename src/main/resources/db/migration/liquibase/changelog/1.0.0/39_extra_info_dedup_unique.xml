<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
      http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="schema_name" value="sert_ingestor"/>

    <!--
      Rende idempotente l'ingestion di EXTRA_INFO. L'insert (BulkWriterImpl.batchInsertExtraInfo) non
      aveva ne ON CONFLICT ne un vincolo unique, quindi il riprocessamento in catch-up (retry dello
      staging / overlap delle finestre) generava righe duplicate a parita di
      (fk_token, info_name, info_value). Qui: (1) deduplica le righe esistenti tenendo il min(id) per
      chiave; (2) crea l'unique index che abilita l'ON CONFLICT DO NOTHING lato applicazione.
      NOTA PROD: extra_info e' grande (~64M) e partizionata: la DELETE di dedup e il build dell'unique
      index sono operazioni pesanti (lock/tempo). In prod valutare l'esecuzione manuale per-partizione
      in finestra a basso carico prima del deploy (la DELETE e' idempotente: se gia' fatta non trova nulla).
    -->
    <changeSet id="20260922-extra-info-dedup" author="system">
        <sql>
            DELETE FROM ${schema_name}.extra_info a
            USING ${schema_name}.extra_info b
            WHERE a.date_event = b.date_event
              AND a.fk_token   = b.fk_token
              AND a.info_name  = b.info_name
              AND a.info_value = b.info_value
              AND a.id > b.id
        </sql>
        <rollback/>
    </changeSet>

    <changeSet id="20260922-extra-info-unique-index" author="system">
        <sql>CREATE UNIQUE INDEX IF NOT EXISTS UQ_EXTRA_INFO_FKTOKEN_NAME_VALUE
             ON ${schema_name}.extra_info (fk_token, info_name, info_value, date_event)</sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS ${schema_name}.UQ_EXTRA_INFO_FKTOKEN_NAME_VALUE</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
