<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
      http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <property name="schema_name" value="sert_ingestor"/>

    <changeSet id="20260610-events-wf-psp-columns" author="copilot">
        <addColumn schemaName="${schema_name}" tableName="EVENTS_WF">
            <column name="PSP" type="SMALLINT"/>
            <column name="INTERMEDIARIO_PSP" type="SMALLINT"/>
            <column name="CANALE" type="SMALLINT"/>
        </addColumn>

        <rollback>
            <dropColumn schemaName="${schema_name}" tableName="EVENTS_WF" columnName="PSP"/>
            <dropColumn schemaName="${schema_name}" tableName="EVENTS_WF" columnName="INTERMEDIARIO_PSP"/>
            <dropColumn schemaName="${schema_name}" tableName="EVENTS_WF" columnName="CANALE"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
