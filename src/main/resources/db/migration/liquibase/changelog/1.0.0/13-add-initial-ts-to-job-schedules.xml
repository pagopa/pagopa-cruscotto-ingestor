<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-add-initial_ts-to-job_schedules-table" author="system" context="ddl">
        <comment>Add initial_ts column to job_schedules table to track when each entity job first started processing</comment>

        <addColumn tableName="job_schedules" schemaName="sert_ingestor">
            <column name="initial_ts" type="TIMESTAMPTZ">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="job_schedules" schemaName="sert_ingestor" columnName="initial_ts"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
