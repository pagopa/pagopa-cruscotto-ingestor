<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="schema_name" value="sert_ingestor" />

    <changeSet id="20260716-ingest-execution-log-runtime-metrics" author="copilot">
        <addColumn schemaName="${schema_name}" tableName="INGEST_EXECUTION_LOG">
            <column name="ANAGRAFICA_DURATION_MS" type="BIGINT" defaultValueNumeric="0">
