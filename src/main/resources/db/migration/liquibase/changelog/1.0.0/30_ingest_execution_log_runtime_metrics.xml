            </column>
            <column name="FK_POSITION_DURATION_MS" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="FK_TOKEN_DURATION_MS" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="PROCESS_CPU_LOAD_PCT" type="DOUBLE PRECISION" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="JVM_USED_MEMORY_MB" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="JVM_TOTAL_MEMORY_MB" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ANAGRAFICA_LOOKUP_COUNT" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="POSITION_LOOKUP_COUNT" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="TOKEN_LOOKUP_COUNT" type="BIGINT" defaultValueNumeric="0">
