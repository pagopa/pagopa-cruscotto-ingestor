<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="schema_name" value="sert_ingestor" />

    <changeSet id="20260508-ingest-execution-log-latest-checkpoint" author="system">
        <addColumn schemaName="${schema_name}" tableName="INGEST_EXECUTION_LOG">
            <column name="LATEST_CHECKPOINT_TS" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>

        <rollback>
            <dropColumn schemaName="${schema_name}" tableName="INGEST_EXECUTION_LOG" columnName="LATEST_CHECKPOINT_TS"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
