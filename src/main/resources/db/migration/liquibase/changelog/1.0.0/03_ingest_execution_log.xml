<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="schema_name" value="sert_ingestor" />

    <changeSet id="20260508-ingest-execution-log" author="system">
        <createTable schemaName="${schema_name}" tableName="INGEST_EXECUTION_LOG">
            <column name="ID" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="INGEST_EXECUTION_LOG_PK" nullable="false"/>
            </column>
            <column name="RUN_ID" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ENTITY_NAME" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="JOB_NAME" type="VARCHAR(128)"/>
            <column name="STATUS" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="STARTED_AT" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="ENDED_AT" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="DURATION_MS" type="BIGINT"/>
            <column name="RECORDS_READ" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="RECORDS_TRANSFORMED" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="RECORDS_INSERTED" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="RECORDS_DISCARDED" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="RECORDS_STAGED" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ERROR_CODE" type="VARCHAR(128)"/>
            <column name="ERROR_MESSAGE" type="TEXT"/>
            <column name="STAGED_RECORD_IDS" type="JSONB"/>
            <column name="INSERTED_RECORD_IDS" type="JSONB"/>
            <column name="CREATED_AT" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex schemaName="${schema_name}" indexName="IDX_INGEST_EXECUTION_LOG_CREATED_AT" tableName="INGEST_EXECUTION_LOG">
            <column name="CREATED_AT"/>
        </createIndex>

        <createIndex schemaName="${schema_name}" indexName="IDX_INGEST_EXECUTION_LOG_RUN_ID" tableName="INGEST_EXECUTION_LOG">
            <column name="RUN_ID"/>
        </createIndex>

        <createIndex schemaName="${schema_name}" indexName="IDX_INGEST_EXECUTION_LOG_ENTITY_STATUS" tableName="INGEST_EXECUTION_LOG">
            <column name="ENTITY_NAME"/>
            <column name="STATUS"/>
        </createIndex>

        <sql>
            ALTER TABLE ${schema_name}.INGEST_EXECUTION_LOG
            ADD CONSTRAINT CHK_INGEST_EXECUTION_LOG_STATUS
            CHECK (STATUS IN ('STARTED', 'RUNNING', 'COMPLETED', 'FAILED'));
        </sql>

        <rollback>
            DROP TABLE ${schema_name}.INGEST_EXECUTION_LOG CASCADE;
        </rollback>
    </changeSet>
</databaseChangeLog>
