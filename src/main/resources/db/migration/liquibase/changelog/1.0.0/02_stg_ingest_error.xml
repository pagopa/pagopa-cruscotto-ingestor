<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="schema_name" value="sert_ingestor" />

    <changeSet id="20260507-stg-ingest-error" author="copilot">
        <createTable schemaName="${schema_name}" tableName="STG_INGEST_ERROR">
            <column name="ID" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="STG_INGEST_ERROR_PK" nullable="false"/>
            </column>
            <column name="RUN_ID" type="VARCHAR(100)"/>
            <column name="ENTITY_NAME" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="SOURCE_KEY" type="VARCHAR(255)"/>
            <column name="PAYLOAD_JSON" type="JSONB"/>
            <column name="ERROR_CODE" type="VARCHAR(128)"/>
            <column name="ERROR_MESSAGE" type="TEXT"/>
            <column name="CREATED_AT" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="RETRY_COUNT" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_RETRY_AT" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <createIndex schemaName="${schema_name}" indexName="IDX_STG_INGEST_ERROR_ENTITY_STATUS_CREATED" tableName="STG_INGEST_ERROR">
            <column name="ENTITY_NAME"/>
            <column name="STATUS"/>
            <column name="CREATED_AT"/>
        </createIndex>

        <sql>
            ALTER TABLE ${schema_name}.STG_INGEST_ERROR
            ADD CONSTRAINT CHK_STG_INGEST_ERROR_STATUS
            CHECK (STATUS IN ('PENDING', 'DONE'));
        </sql>

        <rollback>
            DROP TABLE ${schema_name}.STG_INGEST_ERROR CASCADE;
        </rollback>
    </changeSet>
</databaseChangeLog>


