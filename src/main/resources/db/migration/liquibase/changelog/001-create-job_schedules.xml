<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-job_schedules-table" author="copilot" context="ddl">
        <comment>Create job_schedules table to persist checkpoint information for ingestion jobs</comment>

        <createTable tableName="job_schedules" schemaName="ingestor">
            <column name="entity_name" type="VARCHAR(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="checkpoint_ts" type="TIMESTAMPTZ">
                <constraints nullable="true"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="true"/>
            </column>
            <column name="last_run_id" type="VARCHAR(36)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="job_schedules" schemaName="ingestor"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

